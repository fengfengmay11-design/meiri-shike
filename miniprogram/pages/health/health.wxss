/* pages/health/health.wxss */
.today-card {
  background: linear-gradient(135deg, #ff8a5c, #ff6b35);
  color: #fff;
  padding: 32rpx 28rpx 24rpx;
}

/* 第一行：日期 | 右侧（头像+设目标） */
.today-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.today-date {
  font-size: 28rpx;
  opacity: 0.95;
  font-weight: 500;
}

.today-top-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.today-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,0.5);
  overflow: hidden;
  flex-shrink: 0;
  background: rgba(255,255,255,0.2);
}
.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

/* 设目标小按钮（在日期行右侧） */
.target-btn {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255,255,255,0.5);
  border-radius: 999rpx;
  opacity: 0.9;
}

/* 第二行：两大指标 */
.today-row {
  display: flex;
  justify-content: space-around;
  margin: 20rpx 0 16rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-num {
  font-size: 40rpx;
  font-weight: 700;
}

.metric-main {
  font-size: 48rpx;
  font-weight: 700;
}

.metric-sub {
  font-size: 26rpx;
  font-weight: 400;
  opacity: 0.75;
}

.metric-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

/* 第三行：进度条 + 百分比内嵌 */
.prog-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
}

.prog-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 999rpx;
  overflow: hidden;
}

.prog-fill {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.prog-pct {
  font-size: 22rpx;
  font-weight: 600;
  opacity: 0.9;
  min-width: 56rpx;
  text-align: right;
}

/* 日历 */
.cal-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.cal-week {
  display: flex;
}

.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-sub);
  padding: 10rpx 0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.28%;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.cal-empty {
  visibility: hidden;
}

.cal-day {
  font-size: 28rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
}

.cal-today .cal-day {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  position: absolute;
  bottom: 8rpx;
}

.cal-legend {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
}

/* 浮窗遮罩：半透明、点击空白处关闭 */
.pop-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.32);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: maskIn 0.22s ease;
}
.pop-mask.mask-closing {
  background: rgba(0, 0, 0, 0);
  animation: maskOut 0.28s ease forwards;
}
@keyframes maskIn { from { background: rgba(0,0,0,0); } to { background: rgba(0,0,0,0.32); } }
@keyframes maskOut { from { background: rgba(0,0,0,0.32); } to { background: rgba(0,0,0,0); } }

/* 浮窗本体：由小变大 */
.pop {
  width: 80vw;
  max-height: 64vh;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 24rpx 70rpx rgba(0, 0, 0, 0.28);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: scale(1);
  opacity: 1;
  transform-origin: center;
  transition: transform 0.3s cubic-bezier(0.2, 0.85, 0.3, 1.15),
              opacity 0.25s ease,
              width 0.3s ease,
              max-height 0.3s ease;
}
/* 入场：从很小淡入 */
.pop.pop-enter {
  transform: scale(0.2);
  opacity: 0;
}
/* 退场：缩回很小淡出 */
.pop.pop-closing {
  transform: scale(0.2);
  opacity: 0;
}

/* 头部：日期居中 + 关闭在右上角 */
.pop-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx 28rpx 18rpx;
  border-bottom: 1rpx solid var(--line);
}
.pop-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.pop-shut {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-sub);
  border: 1rpx solid var(--line);
  border-radius: 50%;
}

/* 左右切换栏 */
.pop-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx 6rpx;
}
.pop-sw-btn {
  font-size: 26rpx;
  color: #ff6b35;
  background: #fff1ea;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.pop-sw-hint {
  font-size: 22rpx;
  color: var(--text-sub);
}

.pop-scroll {
  flex: 1;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

/* 紧凑指标 */
.pop-metrics {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}
.pop-metric { text-align: center; }
.pop-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}
.pop-l {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

/* 记录字段 */
.pop-fields {
  border-top: 1rpx solid var(--line);
  padding-top: 8rpx;
}
.pop-field {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.pop-fl {
  width: 140rpx;
  font-size: 28rpx;
  color: #5a6068;
}
.pop-fi {
  flex: 1;
  font-size: 30rpx;
}
/* 照片：上下滑动 */
.pop-photo-title {
  font-size: 26rpx;
  color: #5a6068;
  margin: 22rpx 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pop-upload {
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff1ea;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 600;
}
.pop-photos {
  display: flex;
  flex-direction: column;
}
.pop-photo {
  width: 100%;
  height: 240rpx;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}
.pop-photo-img {
  width: 100%;
  height: 100%;
}
.pop-empty {
  font-size: 24rpx;
  color: var(--text-sub);
  text-align: center;
  padding: 60rpx 0;
}

/* 底部 */
.pop-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx 24rpx;
  border-top: 1rpx solid var(--line);
}
.pop-hint {
  font-size: 22rpx;
  color: var(--text-sub);
}
.pop-save {
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8a5c, #ff6b35);
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
}

/* ===== 餐食照片三餐分组 ===== */
.photo-sec { margin-bottom: 20rpx; }
.photo-sec-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.photo-sec-label { font-size: 24rpx; font-weight: 700; color: #1E1E1E; }
.photo-sec-actions { display: flex; gap: 12rpx; }
.photo-action {
  font-size: 20rpx;
  color: #FF6B35;
  background: #FFF3ED;
  padding: 6rpx 20rpx;
  border-radius: 999px;
  font-weight: 700;
}
.photo-action-wx { color: #07C160; background: #E8F8EF; }
.photo-sec-scroll { white-space: nowrap; }
.photo-thumb {
  display: inline-block;
  width: 144rpx;
  height: 144rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-right: 12rpx;
  position: relative;
  background: #F9F7F4;
}
.photo-thumb-img { width: 100%; height: 100%; }
.photo-del {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0,0,0,.5);
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-empty-sm { font-size: 22rpx; color: #B0B0B0; padding: 12rpx 0; }
