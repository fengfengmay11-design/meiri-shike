/* app.wxss  全局样式 */
page {
  --primary: #ff6b35;
  --primary-soft: #fff1ea;
  --bg: #f5f6f8;
  --card: #ffffff;
  --text: #1f2329;
  --text-sub: #8a9099;
  --line: #eef0f3;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.05);
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  color: var(--text-sub);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: 999rpx;
  text-align: center;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-ghost {
  background: var(--primary-soft);
  color: var(--primary);
  border-radius: 999rpx;
  text-align: center;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

.btn-ghost:active {
  opacity: 0.8;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--primary);
  background: var(--primary-soft);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin: 0 12rpx 12rpx 0;
}

.tag-off {
  color: var(--text-sub);
  background: #f1f2f4;
}
